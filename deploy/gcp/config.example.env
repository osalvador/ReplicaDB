# Copy this file to config.env and keep the copy out of version control.
REPLICADB_GCP_PROJECT=
REPLICADB_GCP_REGION=europe-west4
REPLICADB_GCP_MODE=simple
REPLICADB_SERVER_VERSION=1.0.0
# Use an immutable digest for production deployments when registry inspection is unavailable.
REPLICADB_SERVER_DIGEST=
REPLICADB_ARTIFACT_REGISTRY_IMAGE=
REPLICADB_ALLOW_LATEST=false
REPLICADB_DEPLOYMENT_ID=
REPLICADB_STATE_FILE=
REPLICADB_GCP_NETWORK=
REPLICADB_GCP_SUBNET=
REPLICADB_CLOUD_SQL_INSTANCE=
REPLICADB_CLOUD_SQL_CONNECTION=
REPLICADB_DATABASE=replicadb
REPLICADB_DB_USER=replicadb
# Existing DB_URL values are read but never printed or written to state.
REPLICADB_DB_URL=
REPLICADB_API_SERVICE_ACCOUNT=
REPLICADB_WORKER_SERVICE_ACCOUNT=
REPLICADB_PUBLIC_ACCESS=false
# Keep the public control plane at one instance so Quartz scheduling stays active.
REPLICADB_API_MIN_INSTANCES=1
REPLICADB_API_MAX_INSTANCES=10
REPLICADB_WORKER_INSTANCES=1
REPLICADB_DB_USERNAME_SECRET=replicadb-db-username
REPLICADB_DB_PASSWORD_SECRET=replicadb-db-password
REPLICADB_BOOTSTRAP_USERNAME_SECRET=replicadb-bootstrap-admin-username
REPLICADB_BOOTSTRAP_PASSWORD_SECRET=replicadb-bootstrap-admin-password
REPLICADB_KEYRING_VERSION_SECRET=replicadb-keyring-current-version
REPLICADB_KEYRING_KEY_SECRET=replicadb-keyring-current-key
REPLICADB_KEYRING_FILE_SECRET=replicadb-master-key
REPLICADB_DB_USERNAME_SECRET_VERSION=
REPLICADB_DB_PASSWORD_SECRET_VERSION=
REPLICADB_BOOTSTRAP_USERNAME_SECRET_VERSION=
REPLICADB_BOOTSTRAP_PASSWORD_SECRET_VERSION=
REPLICADB_KEYRING_VERSION_SECRET_VERSION=
REPLICADB_KEYRING_KEY_SECRET_VERSION=
# Required only with --create-cloud-sql; never commit this value.
REPLICADB_CONFIRMATION=
