---
interface SupportRow {
  name: string;
  sourceModes: string[];
  sinkModes: string[];
  staging: string;
  caveat: string;
}

interface Props {
  caption?: string;
  rows: SupportRow[];
}

const {
  caption = 'Connector support summary',
  rows
} = Astro.props;
---

<div class="support-matrix" tabindex="0" role="region" aria-label={caption}>
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Connector</th>
        <th scope="col">Source modes</th>
        <th scope="col">Sink modes</th>
        <th scope="col">Staging</th>
        <th scope="col">Caveat</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.name}</th>
          <td>
            {row.sourceModes.length > 0
              ? row.sourceModes.map((mode) => <span class="support-matrix__mode">{mode}</span>)
              : 'Not supported'}
          </td>
          <td>
            {row.sinkModes.length > 0
              ? row.sinkModes.map((mode) => <span class="support-matrix__mode">{mode}</span>)
              : 'Not supported'}
          </td>
          <td>{row.staging}</td>
          <td>{row.caveat}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
