{
  "name": "replicadb-docs",
  "version": "1.0.0",
  "private": true,
  "description": "ReplicaDB documentation portal.",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "astro dev",
    "check:content-slugs": "node scripts/check-content-slugs.mjs",
    "check": "npm run check:content-slugs && astro check",
    "build": "npm run check:content-slugs && astro build && npm run stage:static-tools",
    "preview": "astro preview",
    "validate": "node scripts/validate-docs.mjs",
    "stage:static-tools": "node scripts/stage-static-tools.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:all": "npm run check && npm run build && npm run validate && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.0",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.1",
    "mermaid": "11.17.2",
    "sharp": "0.35.4",
    "starlight-openapi": "0.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.49.1",
    "jsdom": "25.0.1",
    "parse5": "^7.3.0",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
