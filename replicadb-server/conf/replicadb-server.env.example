# Copy to a managed environment file; do not commit resolved values.
REPLICADB_SERVER_HOME=${HOME}/.replicadb
REPLICADB_SECURITY_MASTER_KEY_FILE=${REPLICADB_SERVER_HOME}/security/master-key.json
REPLICADB_WORKER_MANAGEMENT_PORT=9091
REPLICADB_WORKER_MANAGEMENT_ADDRESS=127.0.0.1

# Required for api and worker modes.
DB_URL=jdbc:postgresql://db.example.invalid:5432/replicadb
DB_USERNAME=<managed-database-user>
DB_PASSWORD=<managed-database-password>

# Required only for the first local administrator bootstrap.
REPLICADB_BOOTSTRAP_ADMIN_USERNAME=<local-admin>
REPLICADB_BOOTSTRAP_ADMIN_PASSWORD=<managed-bootstrap-password>
